# ---- Free option: Google Gemini (recommended -- one key, chat + embeddings) ----
# Get a free key (no credit card) at https://aistudio.google.com/apikey
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-3.6-flash
JUDGE_MODEL=gemini-3.6-flash

# ---- Default: OpenAI (paid) ----
# LLM_API_KEY=your_openai_api_key_here
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# (leave LLM_BASE_URL unset/commented to use OpenAI's default servers)

# ---- Free option: Groq (chat only -- extremely fast, no embeddings endpoint) ----
# Get a free key at https://console.groq.com/keys
# If you use this, keep EMBEDDING_MODEL pointed at Gemini or run embeddings locally --
# Groq's endpoint doesn't serve an embeddings model.
# LLM_API_KEY=your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=llama-3.3-70b-versatile
# JUDGE_MODEL=llama-3.3-70b-versatile

# ---- Free option: local Ollama (fully free, no API key, no internet needed) ----
# Install Ollama, then: ollama pull llama3.2 && ollama pull nomic-embed-text
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# CHAT_MODEL=llama3.2
# JUDGE_MODEL=llama3.2
